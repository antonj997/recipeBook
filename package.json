{
  "name": "recipiebook",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "concurrently --kill-others \"node server/index.mjs\" \"ng serve --proxy-config src/proxy.conf.json\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:importer": "node --test supabase/functions/_shared/recipe-parser.test.mjs supabase/functions/_shared/public-fetch.test.mjs server/importer.test.mjs",
    "prebuild": "node scripts/configure-supabase.mjs",
    "prestart": "node scripts/configure-supabase.mjs",
    "predev": "node scripts/configure-supabase.mjs",
    "catalog:update": "node scripts/shopping-catalog/generate.mjs",
    "catalog:test": "node --test scripts/shopping-catalog/catalog.test.mjs",
    "catalog:benchmark": "node scripts/shopping-catalog/benchmark.mjs"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "22.1.7",
    "@supabase/supabase-js": "2.117.2",
    "cheerio": "^1.2.0",
    "dexie": "^4.4.6",
    "express": "^5.2.1",
    "htmlparser2": "10.1.0",
    "ipaddr.js": "2.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "concurrently": "^9.2.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
